server {
    listen 80;
    server_name pnl.zarenta.ir;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name pnl.zarenta.ir;

    ssl_certificate /etc/letsencrypt/live/zarenta.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zarenta.ir/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    root /var/www/pnl.zarenta.ir;
    index index.html;

    error_log /var/log/nginx/pnl_zarenta_error.log;
    access_log /var/log/nginx/pnl_zarenta_access.log;

    # App shell / SW metadata: always revalidate
    # (exact locations override the immutable JS rule below)
    location = /index.html {
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        expires 0;
    }

    location = /ngsw.json {
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        expires 0;
    }

    location = /ngsw-worker.js {
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        expires 0;
    }

    location = /manifest.webmanifest {
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        expires 0;
    }

    # Hashed build assets + static media: long-lived cache
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|woff2|woff|ttf|svg)$ {
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ /\.ht {
        deny all;
    }
}
